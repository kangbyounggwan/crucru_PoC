# ===== App (Next.js) =====
# Public URL of THIS app (used to build OAuth redirect_uri)
APP_BASE_URL=http://localhost:3000
# Page tokens are handed back to after login
FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback

# ===== Supabase =====
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== JWT =====
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ===== Kakao =====  developers.kakao.com (REST API key = client id)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ===== Google =====  console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Naver =====  developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ===== Apple =====  developer.apple.com (Sign in with Apple)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
